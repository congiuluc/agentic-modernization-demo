@model List<Comment>
<h1>Pending comments</h1><p>Only approved comments are visible to readers.</p>
@foreach (var comment in Model) {
    <article class="card admin-row" data-comment-id="@comment.Id"><div><h2>@comment.Author</h2><p>On @comment.Post.Title</p><p class="prose">@comment.Body</p></div>
    <div class="actions"><form class="inline" method="post" action="/admin/comments/@comment.Id/approve">@Html.AntiForgeryToken()<button type="submit">Approve</button></form>
    <form class="inline" method="post" action="/admin/comments/@comment.Id/delete">@Html.AntiForgeryToken()<button class="danger" type="submit">Delete</button></form></div></article>
}
@if (Model.Count == 0) { <p class="empty">All caught up. No pending comments.</p> }
