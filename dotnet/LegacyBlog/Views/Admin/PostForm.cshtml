@model PostForm
@{ var categories = (List<Category>)ViewBag.Categories; }
<h1>@(ViewBag.Id == null ? "New draft" : "Edit story")</h1><p>Saving does not change publication status. Publish from the stories list.</p>
<form class="editor card" method="post">@Html.AntiForgeryToken()@Html.ValidationSummary(false)
<label for="Title">Title</label>@Html.TextBoxFor(m => m.Title, new { maxlength = 200, required = "required" })
<label for="Slug">Slug</label>@Html.TextBoxFor(m => m.Slug, new { maxlength = 150, pattern = "[a-z0-9]+(-[a-z0-9]+)*", required = "required" })
<label for="CategoryId">Category</label>@Html.DropDownListFor(m => m.CategoryId, new SelectList(categories, "Id", "Name"), "Select category")
<label for="Body">Body (plain text)</label>@Html.TextAreaFor(m => m.Body, new { rows = 14, maxlength = 50000, required = "required" })
<div class="actions"><button type="submit">Save post</button><a href="/admin/posts">Cancel</a></div></form>
