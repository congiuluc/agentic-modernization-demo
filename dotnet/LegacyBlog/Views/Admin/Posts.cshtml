@model PostList
<div class="section-heading"><h1>Stories</h1><a class="button" href="/admin/posts/create">New post</a></div>
@foreach (var post in Model.Posts) {
    <article class="card admin-row" data-post-id="@post.Id"><div><h2>@post.Title</h2><p><code>@post.Slug</code> / @(post.Published ? "Published" : "Draft")</p></div>
    <div class="actions"><a href="/admin/posts/@post.Id/edit">Edit</a>
    <form class="inline" method="post" action="/admin/posts/@post.Id/@(post.Published ? "unpublish" : "publish")">@Html.AntiForgeryToken()<button type="submit">@(post.Published ? "Unpublish" : "Publish")</button></form>
    <a href="/admin/posts/@post.Id/delete">Delete</a></div></article>
}
@if (Model.Posts.Count == 0) { <p class="empty">No posts yet.</p> }
<nav class="pagination" aria-label="Pagination">@if (Model.Page > 1) { <a href="?page=@(Model.Page - 1)">Previous</a> }<span>Page @Model.Page</span>@if ((long)Model.Page * 10 < Model.Total) { <a href="?page=@(Model.Page + 1)">Next</a> }</nav>
