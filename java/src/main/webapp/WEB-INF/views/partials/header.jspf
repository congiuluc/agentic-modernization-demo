<%@ page contentType="text/html; charset=UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="f" uri="http://www.springframework.org/tags/form" %>
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Fieldnotes | Legacy Blog</title><link rel="stylesheet" href="<c:url value='/assets/site.css'/>"></head><body>
<header class="site-header"><a class="brand" href="<c:url value='/'/>">Fieldnotes<span>THE ENGINEERING JOURNAL</span></a>
<nav aria-label="Main navigation"><a href="<c:url value='/'/>">Journal</a>
<c:choose><c:when test="${not empty pageContext.request.userPrincipal}">
<a href="<c:url value='/admin'/>">Admin</a>
<form class="inline" method="post" action="<c:url value='/account/logout'/>"><%@ include file="csrf.jspf" %><button class="link" type="submit">Sign out</button></form>
</c:when><c:otherwise><a href="<c:url value='/account/login'/>">Sign in</a></c:otherwise></c:choose></nav></header>
<main><div class="eyebrow">JAVA 11 / SPRING MVC 5</div>
